# ---------------------------------------------------------------------------
# Fydio — Supabase stack secrets
#
# Generated by `pnpm secrets:generate`, which fills in only the blanks. Re-running
# never rotates a live secret, so it is safe to run on an existing checkout.
# This file is a template; the real `.env` is gitignored.
#
# Length requirements are enforced by the services themselves and are documented
# here so a short value is never a mystery.
#
# PRODUCTION / COOLIFY DEPLOYMENT:
# In Coolify (Resource 1: Docker Compose), provide these variables in the Coolify
# Environment UI. Ensure JWT_SECRET (>=32 chars), POSTGRES_PASSWORD, SECRET_KEY_BASE
# (>=64 chars), and VAULT_ENC_KEY (32 hex) are securely generated random secrets.
# Set SUPABASE_PUBLIC_URL=https://api.<domain> and SITE_URL=https://app.<domain>.
# ---------------------------------------------------------------------------

############
# Postgres
############
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=54322

############
# Auth / API keys
############
# Legacy symmetric HS256 signing key. Must be at least 32 characters.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=3600

# Legacy HS256 API keys (anon / service_role).
# Left blank by default: generate them with `sh utils/generate-keys.sh` from the
# Supabase repo, or let scripts/generate-secrets.sh mint a compatible pair.
ANON_KEY=
SERVICE_ROLE_KEY=

# Studio login. Change before exposing anything.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

############
# Encryption keys
############
# Realtime + pooler encryption. Must be at least 64 characters.
#   openssl rand -base64 48
SECRET_KEY_BASE=

# Realtime field encryption. Must be exactly 16 characters.
#   openssl rand -hex 8
REALTIME_DB_ENC_KEY=

# Supavisor config encryption. Must be exactly 32 characters.
#   openssl rand -hex 16
VAULT_ENC_KEY=

# Studio connection-string encryption. Must be at least 32 characters.
#   openssl rand -base64 24
PG_META_CRYPTO_KEY=

# Image proxy URL signing.
#   openssl rand -hex 16
IMGPROXY_KEY=
IMGPROXY_AUTO_WEBP=true

############
# URLs
############
# Where the browser reaches the gateway. This is what the app's SUPABASE_URL
# and NEXT_PUBLIC_SUPABASE_URL must match.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000

# Auth's externally-visible origin, and the PATH it puts in sign-in emails. The path must
# include `/auth/v1` because that is the gateway route that exists; the origin must not, because
# a path there is discarded when the link is resolved. See the note in docker-compose.yml --
# getting this wrong 401s every sign-in link a member receives.
GOTRUE_API_EXTERNAL_URL=http://localhost:8000
GOTRUE_MAILER_URLPATHS_MAGICLINK=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**
ENABLE_EMAIL_SIGNUP=true
# INVITE-ONLY (T03). `true` is load-bearing, not a hardening default: with open
# sign-up GoTrue will mint an account for any address, which makes the whole
# invite gate cosmetic. Set to false means `signInWithOtp` only succeeds for an
# account that already exists -- which is the correct shape here, because invite
# acceptance creates the account via `auth.admin.createUser` FIRST and the
# magic-link sign-in happens afterwards.
DISABLE_SIGNUP=true
MFA_ENABLED=false

# Published ports (dev overlay)
API_GW_HTTP_PORT=8000
STUDIO_HOST_PORT=3002
POOLER_PROXY_PORT_TRANSACTION=6543
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

############
# Mail (dev -> Mailpit)
############
# Dev uses Mailpit: nothing leaves the machine. In production point these at a
# real provider and set SMTP_USER/SMTP_PASS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=auth@localhost
SMTP_SENDER_NAME="Fydio Dev"
SMTP_MAX_FREQUENCY=1000000

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_USE_LEGACY_GUCS=false

############
# Storage
############
STORAGE_FILE_SIZE_LIMIT=52428800
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
S3_PROTOCOL_URL=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_ALLOWED_BUCKETS=
REGION=stub
GLOBAL_S3_BUCKET=stub

############
# Functions
############
FUNCTIONS_VERIFY_JWT=false

############
# Pooler
############
POOLER_TENANT_ID=fydio-dev-tenant
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Fydio
STUDIO_DEFAULT_PROJECT=Fydio
OPENAI_API_KEY=

############
# Auth rate limits -- LOCAL ONLY. See the note before the first value.
#
# GoTrue counts `admin.generate_link` -- which is how an invitation is redeemed -- against the
# SAME `EMAIL_SEND` budget that `signInWithOtp` draws from for magic-link sign-in. At the stock
# limit of 30/hour, redeeming a handful of invitations leaves a developer (and the Playwright
# suite, which issues one per test) unable to sign in at all. The failure is a 429 reading "you
# can only request this after 3599999999 seconds", delivered to an empty Mailpit inbox with no
# error in the application -- so it reads as a broken feature rather than a spent budget.
#
# Permissive here because this is a local stack: Mailpit captures the mail, there is no sender
# reputation to burn, and nothing here is reachable from outside the machine. Production limits
# belong to the hosted project.
#
# `supabase/config.toml` mirrors these values for the `supabase start` path; keep the two in step.
GOTRUE_RATE_LIMIT_EMAIL_VERIFICATION=10000
# NOTE: the GoTrue variable is EMAIL_SENT. The EMAIL_SEND name below is not read by
# GoTrue at all -- it is kept only because the compose file has always passed it, and
# removing it would look like a behaviour change when it never had one.
GOTRUE_RATE_LIMIT_EMAIL_SENT=10000
GOTRUE_RATE_LIMIT_EMAIL_SEND=10000

# OTP is the one that actually bites. `/otp` is guarded by `newLimiterPer5mOver1h(RateLimitOtp)`
# -- default 30 per five minutes, burst 30 -- which is checked BEFORE the email limiter and
# reports the same "For security purposes, you can only request this after %d seconds" text with
# `over_email_send_rate_limit`. Raising only EMAIL_SENT therefore appears to do nothing, which is
# exactly what it did here. OTP is also what invite redemption consumes, via generate_link.
GOTRUE_RATE_LIMIT_OTP=10000
GOTRUE_RATE_LIMIT_VERIFY=10000
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=10000
GOTRUE_RATE_LIMIT_SMS_SENT=10000
POOLER_HOST_PORT=54324
