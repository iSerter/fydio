{
  "name": "@fydio/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@fydio/config-eslint": "workspace:*",
    "@fydio/config-typescript": "workspace:*",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
