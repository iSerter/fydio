# Monorepo installs should never hard-fail on an unmet peer range: Next.js and
# the Tailwind/PostCSS toolchain intentionally keep peers wide. Version skew that
# actually matters is caught by `pnpm typecheck` in CI, not by install.
strict-peer-dependencies=false
auto-install-peers=true

# Keep the registry at one version per range so hoisted dev tooling behaves
# identically in CI and on a laptop.
resolution-mode=highest