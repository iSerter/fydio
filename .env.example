# ---------------------------------------------------------------------------
# Fydio — web app environment
#
# Copy to `.env` and run `pnpm secrets:generate` to fill in the Supabase keys.
# NEVER commit a filled-in `.env`. Only `.env.example` is tracked.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=Fydio
APP_URL=http://localhost:3000

# --- Supabase ---
# Points at Kong on the local stack; this is the only Supabase port published in
# dev. Matches SUPABASE_PUBLIC_URL in docker/.env.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional direct Postgres connection, used by the db:* scripts and pgTAP.
# Generated by `pnpm secrets:generate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# --- Browser-visible (inlined into the client bundle at build time) ---
# These must mirror the server values above. Turbo hashes them into the build
# cache key, so a stale build pointed at the wrong URL is not possible.
NEXT_PUBLIC_APP_NAME=Fydio
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EXTENSION_ID=

# --- Feed ranking tunables ---
# Defaults are documented in packages/env/src/schema.ts; you only need to set
# these to override them.
# FEED_PAGE_SIZE=20
# FEED_FRIEND_AFFINITY_BOOST=0.35
# FEED_FRESHNESS_HALF_LIFE_HOURS=36
# FEED_FEEDBACK_NEED_BOOST=0.15
# FEED_DIVERSITY_MAX_PER_CREATOR=2
# FEED_DIVERSITY_MAX_PER_PLATFORM=6
# FEED_MAX_AGE_HOURS=720

# --- Credits ---
# CREDIT_SUBMISSION_COST=1
# CREDIT_WEEKLY_STARTER_ALLOWANCE=3
# CREDIT_PER_DAY_CAP=5
# CREDIT_PER_CREATOR_CAP=2
# CREDIT_HOLD_HOURS=48
# CREDIT_NEW_MEMBER_SUBMISSION_CAP=3
# CREDIT_NEW_MEMBER_GRACE_DAYS=14

# --- Feedback ---
# FEEDBACK_MIN_CHARS=40
# FEEDBACK_MAX_IMAGES=3
# FEEDBACK_EDIT_GRACE_HOURS=48
# RATING_REVISION_WINDOW_HOURS=24

# --- Content / platforms ---
# Comma-separated. Omit a platform to disable it.
# PLATFORM_ALLOWLIST=instagram,tiktok,youtube,x
# URL_PREVIEW_TIMEOUT_MS=4000
# Optional preview providers. Unset by default: Instagram falls back to link
# cards, YouTube uses its public oEmbed endpoint.
# INSTAGRAM_ACCESS_TOKEN=
# YOUTUBE_API_KEY=

# --- Storage buckets ---
# STORAGE_BUCKET_AVATARS=avatars
# STORAGE_BUCKET_COVERS=covers
# STORAGE_BUCKET_FEEDBACK=feedback-images

# --- Extension (optional until T10) ---
# EXTENSION_ID=
# EXTENSION_TOKEN_SECRET=