{
  "name": "@fydio/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "clean": "rm -rf .next .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "bash ../../scripts/db-migrate.sh",
    "db:reset": "bash ../../scripts/db-reset.sh",
    "db:seed": "bash ../../scripts/db-seed.sh",
    "db:types": "bash ../../scripts/db-types.sh"
  },
  "dependencies": {
    "@fydio/domain": "workspace:*",
    "@fydio/env": "workspace:*",
    "@fydio/supabase": "workspace:*",
    "@fydio/ui": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fydio/config-eslint": "workspace:*",
    "@fydio/config-tailwind": "workspace:*",
    "@fydio/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
